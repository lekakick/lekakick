<%- include('partials/header') %><main id="konten" class="container page-main"><div class="breadcrumb"><a href="/">Beranda</a><span>/</span>Berita</div><div class="section-heading"><div><span class="eyebrow">JELAJAHI LAPANGAN</span><h1><%= q ? 'Hasil pencarian' : categoryName(category) %><span class="brand-period">.</span></h1><p class="page-description"><%= q ? `Menampilkan berita untuk “${q}”` : 'Kabar terbaru, langsung dari sumbernya.' %></p></div><span class="result-count"><%= total %> berita</span></div>
<nav class="filter-tabs" aria-label="Filter kategori"><% categories.forEach(c => { %><a href="/berita?<%= new URLSearchParams({kategori:c.id,q}) %>" class="<%= category === c.id ? 'selected' : '' %>" <%- category === c.id ? 'aria-current="page"' : '' %>><%= c.name %></a><% }); %></nav>
<% if (!items.length) { %><section class="empty-state"><span class="empty-mark" aria-hidden="true">↗</span><h2>Belum ada hasil.</h2><p>Coba nama klub, pemain, atau kata kunci lain. Kategori ini mungkin belum memiliki berita dari sumber RSS.</p><a class="button button-dark" href="/berita">Lihat semua berita →</a></section><% } else { %><div class="news-grid listing-grid"><% items.forEach(item => { %><%- include('partials/card',{item}) %><% }); %></div><% } %>
<% if (pages > 1) { %><nav class="pagination" aria-label="Halaman berita"><% if(page > 1) { %><a href="<%= pageLink(page-1) %>" class="button button-outline">← Sebelumnya</a><% } %><span>Halaman <%= page %> dari <%= pages %></span><% if(page < pages) { %><a href="<%= pageLink(page+1) %>" class="button button-dark">Selanjutnya →</a><% } %></nav><% } %></main><%- include('partials/footer') %>
