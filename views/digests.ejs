<%- include('partials/header') %><main id="konten" class="container page-main"><div class="breadcrumb"><a href="/">Beranda</a><span>/</span>Artikel</div><div class="section-heading"><div><span class="eyebrow">DARI BERBAGAI MEDIA</span><h1><%= q ? 'Hasil pencarian' : category === 'semua' ? 'Semua Artikel' : categoryName(category) %><span class="brand-period">.</span></h1><p class="page-description"><%= q ? `Menampilkan artikel untuk “${q}”` : 'Satu peristiwa, dirangkum dari beberapa media sekaligus. Setiap artikel mencantumkan laporan aslinya.' %></p></div><span class="result-count"><%= total %> artikel</span></div>
<nav class="filter-tabs" aria-label="Filter kategori"><% categories.forEach(c => { %><a href="/artikel?<%= new URLSearchParams({...(c.id !== 'semua' ? {kategori:c.id} : {}), ...(q ? {q} : {})}) %>" class="<%= category === c.id ? 'selected' : '' %>" <%- category === c.id ? 'aria-current="page"' : '' %>><%= c.id === 'semua' ? 'Semua Artikel' : c.name %></a><% }); %></nav>
<% if (!items.length) { %><section class="empty-state"><span class="empty-mark" aria-hidden="true">↗</span><h2><%= q ? 'Belum ada hasil.' : 'Artikel segera hadir.' %></h2><p><%= q ? 'Coba nama klub, pemain, atau kata kunci lain.' : 'Artikel dibuat ketika sebuah peristiwa diberitakan oleh beberapa media.' %></p><a class="button button-dark" href="/artikel">Lihat semua artikel →</a></section><% } else { %><div class="news-grid listing-grid"><% items.forEach(item => { %><%- include('partials/digest-card',{item}) %><% }); %></div><% } %>
<% if (pages > 1) { %><nav class="pagination" aria-label="Halaman artikel"><% if(page > 1) { %><a href="<%= pageLink(page-1) %>" class="button button-outline">← Sebelumnya</a><% } %><span>Halaman <%= page %> dari <%= pages %></span><% if(page < pages) { %><a href="<%= pageLink(page+1) %>" class="button button-dark">Selanjutnya →</a><% } %></nav><% } %></main><%- include('partials/footer') %>
