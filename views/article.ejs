<%- include('partials/header') %><main id="konten" class="container page-main article-page"><div class="breadcrumb"><a href="/">Beranda</a><span>/</span><a href="/berita?kategori=<%= article.category %>"><%= categoryName(article.category) %></a><span>/</span>Ringkasan berita</div>
<article class="article-detail"><header class="article-header"><span class="category-label"><%= categoryName(article.category) %></span><h1><%= article.title %></h1><div class="detail-byline"><div><strong>ANTARA News</strong><time datetime="<%= article.publishedAt %>"><%= date(article.publishedAt,true) %></time></div><div class="article-actions"><button class="bookmark button button-outline" data-save="<%= article.id %>" aria-pressed="false"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 4h12v17l-6-4-6 4z"/></svg><span data-save-label>Simpan</span></button><button class="button button-outline" data-share>Bagikan ↗</button></div></div></header>
<figure class="article-figure"><img src="<%= article.image || '/assets/placeholder.svg' %>" alt="<%= article.imageCredit || 'Ilustrasi sepak bola' %>" width="800" height="533"><% if(article.imageCredit) { %><figcaption><%= article.imageCredit %></figcaption><% } %></figure>
<div class="article-body"><span class="eyebrow">RINGKASAN DARI SUMBER RSS</span><p class="article-excerpt"><%= article.excerpt || 'Baca laporan lengkap melalui tautan sumber di bawah.' %></p><div class="original-source"><h2>Lanjutkan cerita di sumber aslinya.</h2><p>GarisBola menampilkan cuplikan RSS, bukan menyalin artikel penuh. Baca laporan lengkap beserta konteks dan pembaruannya di ANTARA News.</p><a class="button button-dark" href="<%= article.url %>" target="_blank" rel="noopener noreferrer">Baca selengkapnya di ANTARA <span aria-hidden="true">↗</span></a></div></div></article>
<% if(related.length) { %><section class="related"><div class="section-heading ruled"><h2>Masih dari <span>lapangan</span></h2><a class="text-link" href="/berita?kategori=<%= article.category %>">Lihat kategori ↗</a></div><div class="news-grid listing-grid"><% related.forEach(item => { %><%- include('partials/card',{item}) %><% }); %></div></section><% } %></main><%- include('partials/footer') %>
