<%- include('partials/header') %>
<main id="konten" class="container home-main">
  <div class="topic-strip"><span class="topic-label">DALAM SOROTAN <span aria-hidden="true">↗</span></span><a href="/artikel?q=Timnas">#TimnasIndonesia</a><a href="/artikel?q=Super%20League">#SuperLeague</a><a href="/artikel?q=ASEAN">#ASEANCup</a><a href="/artikel?kategori=transfer">#BursaTransfer</a></div>
  <div class="section-heading opening"><div><span class="eyebrow"><span class="small-square"></span> KABAR DARI LAPANGAN</span><h1>Bola terus <span>bergulir.</span></h1></div><div class="edition-note">Satu peristiwa, dari banyak media.<br><span>Dirangkum lekakick. Sumber selalu dicantumkan.</span></div></div>
  <% if (lead) { %>
  <section class="lead-grid" aria-label="Berita utama">
    <article class="lead-story"><img class="lead-image" src="<%= lead.image || '/assets/placeholder.svg?v=2' %>" alt="" width="800" height="533" fetchpriority="high"><div class="lead-shade"></div><span class="lead-tag">SOROTAN UTAMA</span><div class="lead-copy"><div class="article-meta"><span class="light-category"><%= categoryName(lead.category) %></span><time datetime="<%= lead.publishedAt %>"><%= date(lead.publishedAt) %></time></div><h2><a href="<%= digestPath(lead) %>"><%= lead.title %></a></h2><p><%= lead.dek %></p><div class="lead-bottom"><span>Redaksi lekakick <span aria-hidden="true">·</span> Rangkuman <%= lead.sources.length %> media</span><a class="round-link" href="<%= digestPath(lead) %>" aria-label="Baca sorotan utama">↗</a></div></div></article>
    <% if (side.length) { %><div class="lead-side"><% side.forEach(item => { %><article class="side-story"><a class="side-image" href="<%= digestPath(item) %>" tabindex="-1" aria-hidden="true"><img src="<%= item.image || '/assets/placeholder.svg?v=2' %>" alt="" width="800" height="533"></a><div class="side-copy"><div class="article-meta"><span class="category-label"><%= categoryName(item.category) %></span><time datetime="<%= item.publishedAt %>"><%= date(item.publishedAt) %></time></div><h2><a href="<%= digestPath(item) %>"><%= item.title %></a></h2><span class="side-source">Rangkuman <%= item.sources.length %> media <span aria-hidden="true">↗</span></span></div></article><% }); %></div><% } %>
  </section>
  <% } else { %><section class="empty-state"><h2>Menunggu kabar dari lapangan.</h2><p>Rangkuman pertama sedang disiapkan dari laporan berbagai media. Silakan kembali sebentar lagi.</p></section><% } %>
  <div class="news-layout"><section class="latest-section"><div class="section-heading ruled"><h2>Artikel <span>terbaru</span></h2><a class="text-link" href="/artikel">Lihat semua <span aria-hidden="true">↗</span></a></div><% if (latest.length) { %><div class="news-grid"><% latest.forEach(item => { %><%- include('partials/digest-card', {item}) %><% }); %></div><% } else { %><p class="page-description">Artikel berikutnya akan muncul di sini.</p><% } %><a class="button button-outline more-news" href="/artikel">Jelajahi semua artikel <span aria-hidden="true">→</span></a></section>
  <aside class="sidebar"><div class="sidebar-heading"><span class="small-square"></span><h2>Sekilas lapangan</h2></div><ol class="spotlight-list"><% spotlight.forEach((item,index) => { %><li><span class="list-number"><%= String(index+1).padStart(2,'0') %></span><div><span class="category-label"><%= categoryName(item.category) %></span><h3><a href="<%= digestPath(item) %>"><%= item.title %></a></h3><time datetime="<%= item.publishedAt %>"><%= date(item.publishedAt) %></time></div></li><% }); %></ol>
    <div class="garuda-block"><span class="eyebrow">SATU TIM. SATU SEMANGAT.</span><span class="garuda-word" aria-hidden="true">KITA<br>GARUDA.</span><p>Ikuti perjalanan Merah Putih,<br>di dalam dan di luar lapangan.</p><a class="button button-yellow" href="/artikel?kategori=timnas">Kabar Timnas <span aria-hidden="true">↗</span></a><span class="pitch-circle" aria-hidden="true"></span></div>
    <div class="source-info"><span class="source-icon" aria-hidden="true">↗</span><h3>Baca kabar, kenali sumbernya.</h3><p>Setiap artikel dirangkum dari beberapa media dan menautkan laporan aslinya. Tanpa skor atau statistik rekaan.</p><a class="text-link" href="/tentang">Cara kami menyusun artikel →</a></div>
  </aside></div>
  <section class="bottom-banner"><div><span class="eyebrow">BOLA TIDAK BERHENTI DI PELUIT AKHIR.</span><h2>Selalu ada cerita berikutnya.</h2></div><a class="button button-dark" href="/artikel?kategori=internasional">Jelajahi bola dunia <span aria-hidden="true">↗</span></a></section>
</main><%- include('partials/footer') %>
