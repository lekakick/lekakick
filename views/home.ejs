<%- include('partials/header') %>
<main id="konten" class="container home-main">
  <div class="topic-strip"><span class="topic-label">DALAM SOROTAN <span aria-hidden="true">↗</span></span><a href="/berita?q=Timnas">#TimnasIndonesia</a><a href="/berita?q=Super%20League">#SuperLeague</a><a href="/berita?q=ASEAN">#ASEANCup</a><a href="/berita?kategori=transfer">#BursaTransfer</a></div>
  <div class="section-heading opening"><div><span class="eyebrow"><span class="small-square"></span> KABAR DARI LAPANGAN</span><h1>Bola terus <span>bergulir.</span></h1></div><div class="edition-note">Cerita terbaru. Perspektif lebih luas.<br><% if (state.updatedAt) { %><span>RSS diperiksa <%= date(state.updatedAt, true) %></span><% } %></div></div>
  <% if (lead) { %>
  <section class="lead-grid" aria-label="Berita utama">
    <article class="lead-story"><img class="lead-image" src="<%= lead.image || '/assets/placeholder.svg?v=2' %>" alt="" width="800" height="533" fetchpriority="high"><div class="lead-shade"></div><span class="lead-tag">SOROTAN UTAMA</span><div class="lead-copy"><div class="article-meta"><span class="light-category"><%= categoryName(lead.category) %></span><time datetime="<%= lead.publishedAt %>"><%= date(lead.publishedAt) %></time></div><h2><a href="<%= articlePath(lead) %>"><%= lead.title %></a></h2><p><%= lead.excerpt %></p><div class="lead-bottom"><span>ANTARA News <span aria-hidden="true">·</span> Ringkasan berita</span><a class="round-link" href="<%= articlePath(lead) %>" aria-label="Baca sorotan utama">↗</a></div></div></article>
    <div class="lead-side"><% side.forEach(item => { %><article class="side-story"><a class="side-image" href="<%= articlePath(item) %>" tabindex="-1" aria-hidden="true"><img src="<%= item.image || '/assets/placeholder.svg?v=2' %>" alt="" width="800" height="533"></a><div class="side-copy"><div class="article-meta"><span class="category-label"><%= categoryName(item.category) %></span><time datetime="<%= item.publishedAt %>"><%= date(item.publishedAt) %></time></div><h2><a href="<%= articlePath(item) %>"><%= item.title %></a></h2><span class="side-source">ANTARA News <span aria-hidden="true">↗</span></span></div></article><% }); %></div>
  </section>
  <% } else { %><section class="empty-state"><h2>Menunggu kabar dari lapangan.</h2><p>Sumber berita belum tersedia. Sistem akan mencoba memperbarui secara otomatis.</p></section><% } %>
  <div class="news-layout"><section class="latest-section"><div class="section-heading ruled"><h2>Berita <span>terbaru</span></h2><a class="text-link" href="/berita">Lihat semua <span aria-hidden="true">↗</span></a></div><div class="news-grid"><% latest.forEach(item => { %><%- include('partials/card', {item}) %><% }); %></div><a class="button button-outline more-news" href="/berita">Jelajahi semua berita <span aria-hidden="true">→</span></a></section>
  <aside class="sidebar"><div class="sidebar-heading"><span class="small-square"></span><h2>Sekilas lapangan</h2></div><ol class="spotlight-list"><% spotlight.forEach((item,index) => { %><li><span class="list-number"><%= String(index+1).padStart(2,'0') %></span><div><span class="category-label"><%= categoryName(item.category) %></span><h3><a href="<%= articlePath(item) %>"><%= item.title %></a></h3><time datetime="<%= item.publishedAt %>"><%= date(item.publishedAt) %></time></div></li><% }); %></ol>
    <div class="garuda-block"><span class="eyebrow">SATU TIM. SATU SEMANGAT.</span><span class="garuda-word" aria-hidden="true">KITA<br>GARUDA.</span><p>Ikuti perjalanan Merah Putih,<br>di dalam dan di luar lapangan.</p><a class="button button-yellow" href="/berita?kategori=timnas">Kabar Timnas <span aria-hidden="true">↗</span></a><span class="pitch-circle" aria-hidden="true"></span></div>
    <div class="source-info"><span class="source-icon" aria-hidden="true">↗</span><h3>Baca kabar, kenali sumbernya.</h3><p>Setiap berita dilengkapi sumber dan tautan ke laporan asli. Tanpa skor atau statistik rekaan.</p><a class="text-link" href="/tentang">Tentang kurasi kami →</a></div>
  </aside></div>
  <section class="bottom-banner"><div><span class="eyebrow">BOLA TIDAK BERHENTI DI PELUIT AKHIR.</span><h2>Selalu ada cerita berikutnya.</h2></div><a class="button button-dark" href="/berita?kategori=internasional">Jelajahi bola dunia <span aria-hidden="true">↗</span></a></section>
</main><%- include('partials/footer') %>
